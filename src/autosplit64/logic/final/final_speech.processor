{
  "name": "final_speech",
  "initial_process": "FINAL_ENTRY",
  "inherit": null,
  "sub_processors": {
    "FINAL_ENTRY": "final/final_entry.processor",
    "FINAL_SPEECH": "final/final_speech_wait.processor",
    "FINAL_SPAWN": "final/final_speech_spawn.processor",
    "FINAL_GRAB": "final/final_speech_grab.processor",
    "IDLE": "standard/idle.processor"
  },
  "transitions": {
    "FINAL_ENTRY": {
      "FIND_FINAL_STAGE.ENTERED": "FINAL_SPEECH"
    },
    "FINAL_SPEECH": {
      "FADEOUT.COMPLETE": "FINAL_ENTRY",
      "FIND_BOWSER_SPEECH.SPOKEN": "FINAL_SPAWN"
    },
    "FINAL_SPAWN": {
      "FADEOUT.COMPLETE": "FINAL_ENTRY",
      "FIND_GRAND_STAR.SPAWNED": "FINAL_GRAB"
    },
    "FINAL_GRAB": {
      "FADEOUT.COMPLETE": "FINAL_ENTRY",
      "GRAND_STAR_SPLIT.COMPLETE": "IDLE"
    }
  }
}